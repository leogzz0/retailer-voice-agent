# Copy with `make env` (fills the secrets with random values). .env is git-ignored.

# Shared secret the ElevenLabs agent's tools send as "Authorization: Bearer ...".
# In M3 the same value is stored as an ElevenLabs workspace secret.
NOPALIA_TOOL_API_TOKEN=
# Signs caller-verification tokens. Never leaves the API.
NOPALIA_VERIFICATION_SECRET=
# ElevenLabs post-call webhook HMAC secret. In M3, replace with the one ElevenLabs generates.
NOPALIA_WEBHOOK_SECRET=

# Optional: pin the API clock for reproducible demos (ISO 8601 with offset).
# NOPALIA_FROZEN_NOW=2026-11-09T10:00:00-06:00

# Ticketing stub behavior (local only)
TICKETING_FAILURE_RATE=0.3
TICKETING_LATENCY_MS=150

# M3: used by the ElevenLabs CLI
# ELEVENLABS_API_KEY=
