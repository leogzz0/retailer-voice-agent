# Copy to .env (git-ignored). Only needed when running the API outside Docker.
NOPALIA_DATABASE_URL=postgresql+psycopg://nopalia:nopalia@localhost:5433/nopalia
NOPALIA_ENVIRONMENT=local

# Added in later milestones:
# NOPALIA_TOOL_API_TOKEN=          # M2: bearer token the agent's tools send
# NOPALIA_WEBHOOK_SECRET=          # M2: ElevenLabs post-call webhook HMAC secret
# ELEVENLABS_API_KEY=              # M3: used by the ElevenLabs CLI
