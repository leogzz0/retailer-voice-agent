{
  "type": "webhook",
  "name": "report_incident",
  "description": "Report a delivery problem on one of the verified store's orders. Returns a ticket number to read back.",
  "response_timeout_secs": 10,
  "api_schema": {
    "url": "https://{{system__env_nopalia_api_host}}/v1/customers/{customer_code}/incidents",
    "method": "POST",
    "request_headers": {
      "Authorization": {
        "env_var_label": "nopalia_tool_auth"
      },
      "X-Conversation-Id": {
        "variable_name": "system__conversation_id"
      },
      "X-Verification-Token": {
        "variable_name": "verification_token"
      },
      "Idempotency-Key": {
        "variable_name": "system__conversation_id"
      }
    },
    "path_params_schema": {
      "customer_code": {
        "type": "string",
        "dynamic_variable": "verified_customer_code"
      }
    },
    "request_body_schema": {
      "type": "object",
      "description": "Incident details",
      "properties": {
        "folio": {
          "type": "integer",
          "description": "Folio of the affected order."
        },
        "kind": {
          "type": "string",
          "description": "Type of problem.",
          "enum": [
            "not_delivered",
            "incomplete",
            "damaged",
            "wrong_items",
            "other"
          ]
        },
        "description": {
          "type": "string",
          "description": "One or two sentences in Spanish describing the problem in the caller's words."
        }
      },
      "required": [
        "folio",
        "kind",
        "description"
      ]
    }
  },
  "tool_error_handling_mode": "passthrough"
}
