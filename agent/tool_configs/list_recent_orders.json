{
  "type": "webhook",
  "name": "list_recent_orders",
  "description": "List the verified store's most recent orders (newest first), to find a folio when the caller doesn't know it.",
  "response_timeout_secs": 10,
  "api_schema": {
    "url": "https://{{system__env_nopalia_api_host}}/v1/customers/{customer_code}/orders",
    "method": "GET",
    "request_headers": {
      "Authorization": {
        "env_var_label": "nopalia_tool_auth"
      },
      "X-Conversation-Id": {
        "variable_name": "system__conversation_id"
      },
      "X-Verification-Token": {
        "variable_name": "verification_token"
      }
    },
    "path_params_schema": {
      "customer_code": {
        "type": "string",
        "dynamic_variable": "verified_customer_code"
      }
    },
    "query_params_schema": {
      "properties": {
        "status": {
          "type": "string",
          "description": "Optional filter.",
          "enum": [
            "received",
            "picking",
            "out_for_delivery",
            "delivered",
            "cancelled"
          ]
        },
        "limit": {
          "type": "integer",
          "description": "How many orders, 1 to 10. Default 3."
        }
      },
      "required": []
    }
  },
  "tool_error_handling_mode": "passthrough"
}
